set_min_delay -from [get_clocks {core_clk}] -to [get_pins {camera_capture_fps*~FF|D}] 0.000

# SW3 geometry toggle: asynchronous input, first synchronizer stage only.


# C CPU debug USER2. CDC constraints will be audited after synthesis.
create_clock -period 100.0 -name jtag_inst2_TCK [get_ports {jtag_inst2_TCK}]
set_clock_groups -asynchronous -group {jtag_inst2_TCK} -group {mipi_tx_feedback100}

# C coherent snapshot CDC: exempt only asynchronous first control stages.
set_false_path -from [get_clocks {mipi_tx_feedback100}] -to [get_pins {u_c_nn_bridge/request_sync[0]~FF|D}]
set_false_path -from [get_clocks {core_clk}] -to [get_pins {u_c_nn_bridge/ack_sync[0]~FF|D}]
# held payload is stable before the synchronized ACK and until the next request.

# Raw CPU reset feeds only reset synchronizers. Local reset outputs release
# functional registers on their own clock, whose recovery/removal stays timed.
set_false_path -from [get_clocks {mipi_tx_feedback100}] -to [get_pins {u_c_nn_bridge/src_reset[0]~FF|SR u_c_nn_bridge/src_reset[1]~FF|SR}]

# CPU control command mailbox. Only asynchronous first control stages are cut.
set_false_path -from [get_clocks {mipi_tx_feedback100}] -to [get_pins {u_c_nn_bridge/command_sync[0]~FF|D}]
set_false_path -from [get_clocks {core_clk}] -to [get_pins {u_c_nn_bridge/command_ack_sync[0]~FF|D u_c_nn_bridge/irq_sync[0]~FF|D}]
# Bundled command data stays stable throughout the round-trip handshake.
