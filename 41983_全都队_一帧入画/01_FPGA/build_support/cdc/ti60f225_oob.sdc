# New RX->CPU held report: only first toggle stages are exempt.
set_false_path -from [get_clocks {hdmi_rx_slow_clk}] -to [get_pins {u_hdmi_frontend/u_hdmi_diag/u_snapshot/req_sync[0]~FF|D}]
