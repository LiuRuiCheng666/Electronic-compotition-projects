set_false_path -from [get_clocks {core_clk}] -to [get_pins {u_nn_fps_osd/cpu_ui_meta*~FF|D}]

# Camera bridge reset release stays synchronized locally in each clock domain.

# Read-only A/B video diagnostics: held payloads sampled only after ACK.
set_false_path -from [get_clocks {mipi_tx_feedback100}] -to [get_pins {u_video_diag/core_req_sync[0]~FF|D u_video_diag/pixel_req_sync[0]~FF|D}]
