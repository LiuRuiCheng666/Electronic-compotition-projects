# Capture FPS held-payload handshake (core120 to HDMI148.5).
# The source holds payload until the two-stage request/ack handshake completes.
# Bound the bundled data within10ns; only asynchronous first stages are exempt.
set_false_path -from [get_clocks {hdmi_tx_slow_clk}] -to [get_pins {u_camera_fps_monitor/u_capture_fps_cdc/ack_sync[0]~FF|D}]
set_false_path -from [get_clocks {core_clk}] -to [get_pins {u_camera_fps_monitor/u_capture_fps_cdc/req_sync[0]~FF|D}]
