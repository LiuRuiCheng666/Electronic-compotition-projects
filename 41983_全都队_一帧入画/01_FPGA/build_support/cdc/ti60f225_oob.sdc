set_false_path -from [get_ports {FPGA_HDMI_SCL_IN FPGA_HDMI_SDA_IN}] -to [get_pins {u_hdmi_frontend/u_hdmi_sink/u_edid/scl_sync[0]~FF|D u_hdmi_frontend/u_hdmi_sink/u_edid/sda_sync[0]~FF|D}]
set_false_path -from [get_ports {hdmi_rx_pll_LOCKED}] -to [get_pins {u_hdmi_frontend/u_hdmi_sink/lock_sync[0]~FF|D u_hdmi_frontend/u_hdmi_diag/lock_sync[0]~FF|D u_hdmi_frontend/u_hdmi_adapter/link_sync[0]~FF|D}]
set_false_path -from [get_clocks {hdmi_rx_slow_clk}] -to [get_pins {u_hdmi_frontend/u_hdmi_sink/decoder_sync[0]~FF|D}]

# Inherited DDR-only clock exceptions, retained from verified camera baseline.
set_false_path -from [get_clocks {core_clk mipi_tx_feedback100}] -to [get_clocks {tx_cal_clk}]
set_false_path -from [get_clocks {core_clk mipi_tx_feedback100}] -to [get_clocks {sdram_clk}]
set_false_path -from [get_clocks {core_clk mipi_tx_feedback100}] -to [get_clocks {rx_cal_clk}]
set_false_path -from [get_clocks {tx_cal_clk}] -to [get_clocks {core_clk mipi_tx_feedback100}]
set_false_path -from [get_clocks {tx_cal_clk}] -to [get_clocks {sdram_clk}]
set_false_path -from [get_clocks {tx_cal_clk}] -to [get_clocks {rx_cal_clk}]
set_false_path -from [get_clocks {sdram_clk}] -to [get_clocks {core_clk mipi_tx_feedback100}]
set_false_path -from [get_clocks {sdram_clk}] -to [get_clocks {tx_cal_clk}]
set_false_path -from [get_clocks {sdram_clk}] -to [get_clocks {rx_cal_clk}]
set_false_path -from [get_clocks {rx_cal_clk}] -to [get_clocks {core_clk mipi_tx_feedback100}]
set_false_path -from [get_clocks {rx_cal_clk}] -to [get_clocks {tx_cal_clk}]
set_false_path -from [get_clocks {rx_cal_clk}] -to [get_clocks {sdram_clk}]

# Only dedicated asynchronous reset-release FF pins are exempt.
# Functional logic receives local-clock reset release and remains timed.

# Exact two-stage reset synchronizer SR endpoints, verified from mapped Q->D connectivity.


# Vendor DDR calibration: native routed report proves stage1 Q fanout1,
# then core-clocked areset_1dly D through one LUT, with7.514ns setup margin.
# Exempt only asynchronous first-stage D; reset generation after it stays timed.
set_false_path -from [get_clocks {mipi_tx_feedback100}] -to [get_pins {u_ddr3_top/u_axi4_bus_ctl/mc_init_complete_1dly~FF|D}]

# V6_9 shared PLL outputs. These are concurrent clocks, never exclusive groups.
create_clock -period 20.000 -name i_mipi_rx_pclk [get_ports {i_mipi_rx_pclk}]
create_clock -period 13.468 -name vid_clk_dvi2 [get_ports {vid_clk_dvi2}]
create_clock -period 10.000 -name i_cam_ck_CLKOUT [get_ports {i_cam_ck_CLKOUT}]
set_false_path -from [get_ports {fisheye_sw3_n}] -to [get_pins {u_source_control/button_sync[0]~FF|D}]
set_false_path -from [get_clocks {mipi_tx_feedback100}] -to [get_pins {u_source_mux/request_sync[0]~FF|D}]
set_false_path -from [get_clocks {hdmi_tx_slow_clk}] -to [get_pins {u_source_control/active_sync[0]~FF|D}]
# Only first request/ack stages exempt; stable held report payloads remain bounded.
